# GitHub: fine-grained token com acesso somente leitura a Redacao-Fla10
GITHUB_TOKEN=

# Repositório editorial canônico
EDITORIAL_REPO=rcorreas/Redacao-Fla10
EDITORIAL_BRANCH=main
GITHUB_API_URL=https://api.github.com

# Vault editorial local (somente leitura). Padrão: ~/Documents/Redacao-Fla10
EDITORIAL_VAULT_PATH=

# Bancos SQLite locais. Padrões: data/calendar.db e data/editorial.db
FLA10_DATABASE=
FLA10_EDITORIAL_DATABASE=

# Motor de linguagem. Padrão: opencode (DeepSeek V4.1 Flash Free, custo zero).
# Alternativa opcional: openrouter, que exige OPENROUTER_API_KEY e modelo definido.
FLA10_LLM_ENGINE=opencode

# Executável do OpenCode. Deixe vazio para detectar automaticamente no PATH
# ou no runtime local do OpenBot.
FLA10_OPENCODE_BIN=
FLA10_OPENCODE_TIMEOUT=600

# Modelos de redação e revisão. Padrão: opencode/deepseek-v4.1-flash-free.
FLA10_WRITING_MODEL=
FLA10_REVIEW_MODEL=

# OpenRouter: usado somente se FLA10_LLM_ENGINE=openrouter.
# A avaliação comparativa paga também exige FLA10_ENABLE_PAID_EVALUATION=1.
# Nunca compartilhe, registre em logs ou versione esta chave.
OPENROUTER_API_KEY=
OPENROUTER_API_URL=https://openrouter.ai/api/v1
FLA10_ENABLE_PAID_EVALUATION=

# Opcional: chave direta da OpenAI para futuras integrações que não usem OpenRouter.
OPENAI_API_KEY=
