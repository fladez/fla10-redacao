# GitHub: fine-grained token com acesso somente leitura a Redacao-Fla10
GITHUB_TOKEN=

# Repositório editorial canônico
EDITORIAL_REPO=rcorreas/Redacao-Fla10
EDITORIAL_BRANCH=main
GITHUB_API_URL=https://api.github.com

# Vault editorial local (somente leitura). Padrão: ~/Documents/Redacao-Fla10
EDITORIAL_VAULT_PATH=

# Bancos SQLite locais. Padrões: data/calendar.db e data/editorial.db
FLA10_DATABASE=
FLA10_EDITORIAL_DATABASE=

# OpenRouter: chave usada na avaliação de modelos e na produção/revisão editorial.
# Nunca compartilhe, registre em logs ou versione esta chave.
OPENROUTER_API_KEY=
OPENROUTER_API_URL=https://openrouter.ai/api/v1

# Modelos de redação e revisão. Padrões provisórios: openai/gpt-5.5.
FLA10_WRITING_MODEL=
FLA10_REVIEW_MODEL=

# Opcional: chave direta da OpenAI para futuras integrações que não usem OpenRouter.
OPENAI_API_KEY=
